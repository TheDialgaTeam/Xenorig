#define STR_HELPER(x) #x
#define STR(x) STR_HELPER(x)

#define PROJECT_NAME "${CMAKE_PROJECT_NAME}"
#define PROJECT_SITE "${CMAKE_PROJECT_HOMEPAGE_URL}"

#define COMPILER_ID "${CMAKE_C_COMPILER_ID}"
#define COMPILER_VERSION "${CMAKE_C_COMPILER_VERSION}"

#define APP_VER_MAJOR ${PROJECT_VERSION_MAJOR}
#define APP_VER_MINOR ${PROJECT_VERSION_MINOR}
#define APP_VER_REV ${PROJECT_VERSION_PATCH}
#define APP_VER_BUILD ${PROJECT_VERSION_TWEAK}

#define BUILD_COMMIT_ID "${BUILD_COMMIT_ID}"
#define PROJECT_VERSION STR(APP_VER_MAJOR) "." STR(APP_VER_MINOR) "." STR(APP_VER_REV)
#define PROJECT_VERSION_BUILD_NO STR(APP_VER_BUILD)
#define PROJECT_VERSION_WITH_BUILD PROJECT_VERSION "." PROJECT_VERSION_BUILD_NO 
#define PROJECT_VERSION_LONG PROJECT_VERSION "." PROJECT_VERSION_BUILD_NO " (" BUILD_COMMIT_ID ")"
#define PROJECT_DESCRIPTION PROJECT_NAME " " PROJECT_VERSION_LONG
